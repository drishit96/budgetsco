    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/lodash.defaultsdeep": "^4.6.9",
    "@types/lodash.escaperegexp": "^4.1.9",
    "@types/newrelic": "^9.14.8",
    "@types/pg": "^8.16.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "concurrently": "^9.2.4",
    "esbuild": "^0.25.12",
    "eslint": "^8.57.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.26",
    "prisma": "^7.9.1",
    "rollup-plugin-visualizer": "^5.14.0",
    "tailwindcss": "^4.3.3",
