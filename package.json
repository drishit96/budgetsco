{
  "name": "budgetsco",
  "private": true,
  "description": "",
  "license": "",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "pnpm prisma generate && pnpm build:css && pnpm build:worker && remix vite:build",
    "build:css": "tailwindcss -m -i ./styles/app.css -o app/styles/app.css",
    "build:worker": "esbuild ./app/entry.worker.ts --outfile=./public/entry.worker.js --minify --bundle --format=esm --define:process.env.NODE_ENV='\"production\"'",
    "deploy": "cp ./app/lib/prod.ui.config.ts ./app/lib/ui.config.ts && DEPLOYMENT_TARGET=flyio pnpm build && fly deploy --remote-only",
    "stage-deploy": "cp ./app/lib/test.ui.config.ts ./app/lib/ui.config.ts && NODE_ENV=production DEPLOYMENT_TARGET=vercel pnpm build && vercel deploy --prod",
    "dev": "cp ./app/lib/test.ui.config.ts ./app/lib/ui.config.ts && concurrently \"pnpm dev:css\" \"pnpm dev:worker\" \"remix vite:dev\"",
    "dev:css": "tailwindcss -w -i ./styles/app.css -o app/styles/app.css",
    "dev:worker": "esbuild ./app/entry.worker.ts --outfile=./public/entry.worker.js --bundle --format=esm --define:process.env.NODE_ENV='\"development\"' --watch",
    "start": "cross-env NODE_ENV=production node --enable-source-maps ./server.js",
    "testserver": "cp ./app/lib/test.ui.config.ts ./app/lib/ui.config.ts && cross-env NODE_ENV=production node ./server.js",
    "test:e2e": "node scripts/run-e2e.js"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^1.0.48",
    "@formkit/auto-animate": "^0.8.4",
    "@googleapis/androidpublisher": "^4.4.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@remix-run/express": "^2.17.5",
    "@remix-run/node": "^2.17.5",
    "@remix-run/react": "^2.17.5",
    "@remix-run/serve": "^2.17.5",
    "@remix-run/v1-route-convention": "^0.1.4",
    "@rmwc/dialog": "^7.0.3",
    "@rmwc/ripple": "^7.0.3",
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^13.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^5.0.244",
    "argon2": "^0.43.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.6.1",
    "downshift": "^9.0.13",
    "express": "^4.21.2",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0",
    "isbot": "^5.2.1",
    "lodash.defaultsdeep": "^4.6.1",
    "lodash.escaperegexp": "^4.1.2",
    "match-sorter": "^8.3.0",
    "mixpanel": "^0.23.0",
    "morgan": "^1.11.0",
    "nanoid": "^5.1.16",
    "newrelic": "^12.25.1",
    "otplib": "^12.0.1",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "stripe": "12.6.0",
    "swagger-ui-express": "^5.0.1",
    "workbox-background-sync": "^7.4.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
